<?xml version="1.0" encoding="utf-8"?>
<!-- A header and a scrolling list (the Workers tab: each kind of worker, then its upgrades and its idle slots). The words are
     pictures of text drawn by the app (EtaWidgetText), so the app's fonts show on every launcher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_wk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:background="@drawable/eta_wk_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
        android:id="@+id/eta_wk_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:importantForAccessibility="no" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageView
        android:id="@+id/eta_wk_head_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitEnd"
        android:importantForAccessibility="no" />
    </LinearLayout>
    <ListView
        android:id="@+id/eta_wk_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false" />
    <LinearLayout
        android:id="@+id/eta_wk_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
        android:id="@+id/eta_wk_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
        <ImageView
        android:id="@+id/eta_wk_empty_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
