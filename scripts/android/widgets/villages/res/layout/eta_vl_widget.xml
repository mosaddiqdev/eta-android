<?xml version="1.0" encoding="utf-8"?>
<!-- Up to four rows, each a village (or, with one village, one of its next upgrades). The rows share the height, and the
     renderer hides the ones that don't fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_vl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:background="@drawable/eta_vl_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/eta_vl_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/eta_sans_700"
            android:text="Villages"
            android:textColor="@color/eta_vl_builder"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/eta_vl_head_idle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/eta_sans_700"
            android:text="1 Builder free"
            android:textColor="@color/eta_vl_warn"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/eta_vl_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <ImageView
            android:id="@+id/eta_vl_art0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_vl_tile"
            android:src="@mipmap/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/eta_vl_title0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/eta_sans_700"
                android:text="Main"
                android:textColor="@color/eta_vl_text"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/eta_vl_sub0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Mortar · Level 13 → 14"
                    android:textColor="@color/eta_vl_soft"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/eta_vl_idle0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:fontFamily="@font/eta_sans_700"
                    android:text="1 Builder free"
                    android:textColor="@color/eta_vl_warn"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_vl_when0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/eta_vl_day0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Today"
                android:textColor="@color/eta_vl_soft"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/eta_vl_time0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="10:05 PM"
                android:textColor="@color/eta_vl_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/eta_vl_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
