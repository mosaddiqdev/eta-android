        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                android:id="@+id/eta_vl_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_vl_idle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/eta_vl_sub1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_vl_when1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/eta_vl_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/eta_vl_day1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/eta_vl_div2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="54dp"
        android:background="@drawable/eta_vl_line" />
    <LinearLayout
        android:id="@+id/eta_vl_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/eta_vl_art2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_vl_tile"
            android:src="@mipmap/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                android:id="@+id/eta_vl_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_vl_idle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/eta_vl_sub2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_vl_when2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/eta_vl_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/eta_vl_day2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/eta_vl_div3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="54dp"
        android:background="@drawable/eta_vl_line" />
    <LinearLayout
        android:id="@+id/eta_vl_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/eta_vl_art3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_vl_tile"
            android:src="@mipmap/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                android:id="@+id/eta_vl_title3"
                android:layout_width="wrap_content"
