<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans, the app's own typeface (OFL), as the two weights the widgets use. The app: copies are for Android 7. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/eta_sans_500" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/eta_sans_500" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/eta_sans_700" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/eta_sans_700" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
