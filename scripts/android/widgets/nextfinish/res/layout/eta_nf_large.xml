<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 2: the next finish, big, and where each kind of worker stands. The words here are the sample the widget picker shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_nf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/eta_nf_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/eta_nf_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_nf_tile"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eta_nf_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Next to finish"
                android:textColor="@color/eta_nf_builder"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/eta_nf_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Mortar"
                android:textColor="@color/eta_nf_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eta_nf_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Level 13 → 14"
                android:textColor="@color/eta_nf_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eta_nf_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eta_nf_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Tomorrow"
                android:textColor="@color/eta_nf_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/eta_nf_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="10:05 PM"
                android:textColor="@color/eta_nf_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/eta_nf_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/eta_nf_chip1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/eta_nf_chip">

            <ImageView
                android:id="@+id/eta_nf_chip1_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eta_nf_dot"
                android:tint="@color/eta_nf_builder" />

            <TextView
                android:id="@+id/eta_nf_chip1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Builders"
                android:textColor="@color/eta_nf_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/eta_nf_chip1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eta_nf_chip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/eta_nf_chip">

            <ImageView
                android:id="@+id/eta_nf_chip2_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eta_nf_dot"
                android:tint="@color/eta_nf_lab" />

            <TextView
                android:id="@+id/eta_nf_chip2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Lab"
                android:textColor="@color/eta_nf_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/eta_nf_chip2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="1/1"
                android:textColor="@color/eta_nf_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eta_nf_chip3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/eta_nf_chip">

            <ImageView
                android:id="@+id/eta_nf_chip3_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eta_nf_dot"
                android:tint="@color/eta_nf_pet" />

            <TextView
                android:id="@+id/eta_nf_chip3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Pets"
                android:textColor="@color/eta_nf_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/eta_nf_chip3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="1/1"
                android:textColor="@color/eta_nf_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
