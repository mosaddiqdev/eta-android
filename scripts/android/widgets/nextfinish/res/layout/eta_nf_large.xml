<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 2: the next finish, big, and where each kind of worker stands (the village page's summary tiles). The words are the sample the widget picker shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_nf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/eta_nf_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/eta_nf_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_nf_tile"
            android:src="@mipmap/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/eta_nf_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/eta_sans_700"
                android:text="Next to finish"
                android:textColor="@color/eta_nf_builder"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/eta_nf_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/eta_sans_700"
                android:text="Mortar"
                android:textColor="@color/eta_nf_text"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/eta_nf_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Level 13 → 14"
                android:textColor="@color/eta_nf_soft"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/eta_nf_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Tomorrow"
                android:textColor="@color/eta_nf_soft"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/eta_nf_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="10:05 PM"
                android:textColor="@color/eta_nf_text"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/eta_nf_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/eta_nf_chip1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/eta_nf_chip">
            <ImageView
                android:id="@+id/eta_nf_chip1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/eta_nf_chip1_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_chip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/eta_nf_chip">
            <ImageView
                android:id="@+id/eta_nf_chip2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/eta_nf_chip2_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_chip3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/eta_nf_chip">
            <ImageView
                android:id="@+id/eta_nf_chip3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/eta_nf_chip3_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_chip4"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/eta_nf_chip">
            <ImageView
                android:id="@+id/eta_nf_chip4_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/eta_nf_chip4_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_chip5"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/eta_nf_chip">
            <ImageView
                android:id="@+id/eta_nf_chip5_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/eta_nf_chip5_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/eta_sans_700"
                android:fontFeatureSettings="tnum"
                android:text="6/6"
                android:textColor="@color/eta_nf_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
