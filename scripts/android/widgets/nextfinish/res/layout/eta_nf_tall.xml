<?xml version="1.0" encoding="utf-8"?>
<!-- Tall: from 2 x 4 up to as big as it is made. The picture, the words, then what finishes after it, and the kinds of worker in
     two columns underneath. The renderer sizes the picture and shows only the rows of chips and of "up next" that fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_nf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/eta_nf_bg">
    <ImageView
        android:id="@+id/eta_nf_art"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:background="@drawable/eta_nf_tile"
        android:src="@mipmap/ic_launcher" />
    <ImageView
        android:id="@+id/eta_nf_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scaleType="fitStart"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/eta_nf_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/eta_nf_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/eta_nf_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/eta_nf_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/eta_nf_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">
        <ImageView
        android:id="@+id/eta_nf_queue_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:importantForAccessibility="no" />
        <LinearLayout
            android:id="@+id/eta_nf_q1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/eta_nf_q1_art"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:background="@drawable/eta_nf_tile"
                android:src="@mipmap/ic_launcher" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q1_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q1_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_q2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/eta_nf_q2_art"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:background="@drawable/eta_nf_tile"
                android:src="@mipmap/ic_launcher" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q2_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q2_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_q3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/eta_nf_q3_art"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:background="@drawable/eta_nf_tile"
                android:src="@mipmap/ic_launcher" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q3_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitStart"
                android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:orientation="vertical">
                <ImageView
                android:id="@+id/eta_nf_q3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
                <ImageView
                android:id="@+id/eta_nf_q3_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/eta_nf_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/eta_nf_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/eta_nf_chip1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/eta_nf_chip">
                <ImageView
                    android:id="@+id/eta_nf_chip1_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
                <ImageView
                    android:id="@+id/eta_nf_chip1_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/eta_nf_chip2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/eta_nf_chip">
                <ImageView
                    android:id="@+id/eta_nf_chip2_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
                <ImageView
                    android:id="@+id/eta_nf_chip2_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/eta_nf_chip3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/eta_nf_chip">
                <ImageView
                    android:id="@+id/eta_nf_chip3_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
                <ImageView
                    android:id="@+id/eta_nf_chip3_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/eta_nf_chip4"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/eta_nf_chip">
                <ImageView
                    android:id="@+id/eta_nf_chip4_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
                <ImageView
                    android:id="@+id/eta_nf_chip4_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/eta_nf_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/eta_nf_chip5"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/eta_nf_chip">
                <ImageView
                    android:id="@+id/eta_nf_chip5_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
                <ImageView
                    android:id="@+id/eta_nf_chip5_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/eta_nf_chip6"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
