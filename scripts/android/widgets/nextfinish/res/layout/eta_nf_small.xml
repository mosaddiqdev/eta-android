<?xml version="1.0" encoding="utf-8"?>
<!-- 2 x 2: the picture, what it is, and when it finishes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_nf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/eta_nf_bg">

    <ImageView
        android:id="@+id/eta_nf_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:background="@drawable/eta_nf_tile"
        android:src="@mipmap/ic_launcher" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/eta_nf_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:text="Mortar"
        android:textColor="@color/eta_nf_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eta_nf_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Level 13 → 14"
        android:textColor="@color/eta_nf_soft"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/eta_nf_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eta_nf_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Tomorrow"
            android:textColor="@color/eta_nf_builder"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/eta_nf_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:text="10:05 PM"
            android:textColor="@color/eta_nf_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
