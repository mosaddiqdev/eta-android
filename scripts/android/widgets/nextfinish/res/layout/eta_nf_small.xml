<?xml version="1.0" encoding="utf-8"?>
<!-- 2 x 2: the picture and the day on top, then what it is and the time. Kept short so nothing is cut off on a small cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eta_nf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/eta_nf_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/eta_nf_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:background="@drawable/eta_nf_tile"
            android:src="@mipmap/ic_launcher" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/eta_nf_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/eta_sans"
            android:textStyle="bold"
            android:text="Tomorrow"
            android:textColor="@color/eta_nf_builder"
            android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/eta_nf_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/eta_sans"
        android:textStyle="bold"
        android:text="Mortar"
        android:textColor="@color/eta_nf_text"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/eta_nf_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Level 13 → 14"
        android:textColor="@color/eta_nf_soft"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/eta_nf_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/eta_sans"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:layout_marginTop="2dp"
        android:text="10:05 PM"
        android:textColor="@color/eta_nf_text"
        android:textSize="19sp" />
    <FrameLayout
        android:id="@+id/eta_nf_when"
        android:layout_width="0dp"
        android:layout_height="0dp" />
</LinearLayout>
