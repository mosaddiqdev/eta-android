<?xml version="1.0" encoding="utf-8"?>
<!-- Glass on glass: a lighter pane with its own thin rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eta_nf_tile" />
            <corners android:radius="@dimen/eta_nf_inner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/eta_nf_tile_rim" />
            <corners android:radius="@dimen/eta_nf_inner" />
        </shape>
    </item>
</layer-list>
