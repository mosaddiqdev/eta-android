<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in grid cells on Android 12 and newer (4 x 2 to start), in dp before that. It is never refreshed on a timer:
     NextFinishSchedule wakes it when something finishes and at midnight, and the page when the villages change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/eta_nf_large"
    android:previewLayout="@layout/eta_nf_large"
    android:description="@string/eta_nf_description" />
