---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/plus-jakarta-sans";
// The Latin files cover the text on every screen. Fetched now rather than once the styles have been read, so the
// first paint is already in the real typeface and nothing swaps under a thumb.
import jetbrainsMono from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import plusJakartaSans from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/sheet.css";
import "../styles/skeleton.css";
import "../styles/splash.css";
import Logo from "../ui/Logo.astro";
import SideMenu from "../ui/SideMenu";
import Splash from "../ui/Splash.astro";

interface Props {
  title: string;
  description: string;
  /** Path of the address search engines should index when the same page can be reached at more than one. */
  canonical?: string;
}

const { title, description, canonical } = Astro.props;

// Canonical and social-preview addresses must be absolute. Astro.site comes from `site` in astro.config.mjs.
const origin = Astro.site ?? Astro.url;
const path = canonical ?? (Astro.url.pathname.replace(/\/$/, "") || "/");
const pageUrl = new URL(path, origin).href;
const ogImage = new URL("/og-image.png", origin).href;
const ogAlt =
  "ClashETA: know when to come back to the game. Clash of Clans upgrade finish times, shown on a laptop and two phones.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={plusJakartaSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="canonical" href={pageUrl} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:site_name" content="ClashETA" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ededec" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Before first paint, so a chosen theme never flashes the other one. Same job as applyTheme in src/settings/settings.ts.
      try {
        var theme = JSON.parse(localStorage.getItem("clasheta.settings")).theme;
        if (theme === "dark" || theme === "light") {
          document.documentElement.dataset.theme = theme;
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
            meta.dataset.auto = meta.content;
            meta.content = theme === "dark" ? "#121212" : "#ededec";
          });
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // The launch splash (styles/splash.css) shows once per app start and only inside the app, never in a browser.
      // Not on a page that is about to send the visitor elsewhere (data-leaving, set by the home page): the next page
      // shows it instead. Decided here, before first paint, so the page never shows for a frame and then hides.
      try {
        var cap = window.Capacitor;
        var root = document.documentElement;
        if (
          cap &&
          cap.isNativePlatform &&
          cap.isNativePlatform() &&
          !sessionStorage.getItem("clasheta.splashed") &&
          !root.hasAttribute("data-leaving")
        ) {
          root.setAttribute("data-splash", "");
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // The rest of "behaves like an app" (see base.css): no drag-out of pictures, and on a touch screen no menu when
      // something is held down, except in a field where cut, copy and paste are wanted.
      document.addEventListener("dragstart", function (e) {
        if (e.target instanceof Element && e.target.closest("img, svg")) e.preventDefault();
      });
      document.addEventListener("contextmenu", function (e) {
        var editable = e.target instanceof Element && e.target.closest("input, textarea, [contenteditable]");
        if (!editable && window.matchMedia("(pointer: coarse)").matches) e.preventDefault();
      });
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <Splash />
    <header class="bar page">
      <a class="brand" href="/" aria-label="ClashETA home">
        <Logo />
      </a>
      <SideMenu client:load currentPath={Astro.url.pathname} />
    </header>
    <main class="page"><slot /></main>
    <script>
      import { startApp } from "../native/app";
      startApp();
    </script>
  </body>
</html>
