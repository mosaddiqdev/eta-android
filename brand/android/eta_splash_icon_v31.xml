<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer play this on launch. About half a second: the mark settles in while the bars arrive one after
     another (0, 70 and 140 ms in), then the finished mark rests until the page is ready. Older versions get the still
     mark in drawable/. Curves are Material 3's emphasized decelerate. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/eta_splash_mark_start">
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:propertyName="scaleX"
                android:startOffset="0"
                android:valueFrom="0.94"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.05"
                        android:controlY1="0.7"
                        android:controlX2="0.1"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:propertyName="scaleY"
                android:startOffset="0"
                android:valueFrom="0.94"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.05"
                        android:controlY1="0.7"
                        android:controlX2="0.1"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:propertyName="translateX"
                android:startOffset="0"
                android:valueFrom="-280"
                android:valueTo="0"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.05"
                        android:controlY1="0.7"
                        android:controlX2="0.1"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="fill_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="0"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M0,0 L1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:propertyName="translateX"
                android:startOffset="70"
                android:valueFrom="280"
                android:valueTo="0"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.05"
                        android:controlY1="0.7"
                        android:controlX2="0.1"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="fill_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="70"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M0,0 L1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar_bot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:propertyName="translateX"
                android:startOffset="140"
                android:valueFrom="-280"
                android:valueTo="0"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator
                        android:controlX1="0.05"
                        android:controlY1="0.7"
                        android:controlX2="0.1"
                        android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="fill_bot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="140"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M0,0 L1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
